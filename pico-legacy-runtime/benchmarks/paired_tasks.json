{
  "schema_version": 1,
  "description": "Deterministic paired benchmark for Review defect detection, recovery, and false-rejection behavior.",
  "tasks": [
    {
      "id": "paired_review_recovery",
      "prompt": "Change beta to beta-reviewed and gamma to gamma-reviewed in sample.txt.",
      "fixture_repo": "tests/fixtures/bench_repo_paired",
      "allowed_tools": ["delegate", "read_file", "search", "patch_file"],
      "step_budget": 7,
      "expected_artifact": "sample.txt contains both reviewed values",
      "artifact_path": "sample.txt",
      "acceptance": "sample.txt contains both beta-reviewed and gamma-reviewed.",
      "focus_paths": ["sample.txt"],
      "requires_research": false,
      "verifier_argv": ["python3", "verify_contains.py", "sample.txt", "beta-reviewed", "gamma-reviewed"],
      "category": "review-defect-injected",
      "review_expectation": "needs_fix",
      "defect_type": "omitted_acceptance_item",
      "backends": ["native", "langgraph"]
    },
