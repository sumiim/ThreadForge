# ThreadForge API server configuration.
# Copy to .env and fill only the values you need.

# Loopback only for V1.
THREADFORGE_HOST=127.0.0.1
THREADFORGE_PORT=8000

# Required.
THREADFORGE_DATA_DIR=D:/path/to/threadforge-data
THREADFORGE_WORKSPACES_FILE=D:/path/to/workspaces.json

# Local web console origin.
THREADFORGE_WEB_ORIGIN=http://127.0.0.1:5173

# Timing / limits.
THREADFORGE_APPROVAL_TIMEOUT_SECONDS=1800
THREADFORGE_MODEL_TIMEOUT_SECONDS=120
THREADFORGE_SHELL_CLEANUP_GRACE_SECONDS=5
THREADFORGE_SSE_HEARTBEAT_SECONDS=15
THREADFORGE_MAX_STEPS=6
THREADFORGE_MAX_NEW_TOKENS=512
THREADFORGE_LOG_LEVEL=INFO

# Right Code provider (server-side only; never sent to the browser).
PICO_OPENAI_API_BASE=https://www.right.codes/codex/v1
PICO_OPENAI_API_KEY=
PICO_OPENAI_MODEL=gpt-5.4
