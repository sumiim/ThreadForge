# ThreadForge API server configuration.
# Copy to .env and fill only the values you need.

# Loopback only for V1.
THREADFORGE_HOST=127.0.0.1
THREADFORGE_PORT=8000

# Required.
THREADFORGE_DATA_DIR=D:/path/to/threadforge-data
THREADFORGE_WORKSPACES_FILE=D:/path/to/workspaces.json

# Optional stable owner UUID. When omitted, the server generates one and stores
# it in the data directory. A configured value must match the persisted value.
# THREADFORGE_INSTANCE_OWNER_ID=11111111-1111-4111-8111-111111111111

# Optional GitHub OAuth login. Keep single_owner_instance until every value is
# configured on the server. The owner login inherits existing V1 data.
THREADFORGE_IDENTITY_MODE=single_owner_instance
THREADFORGE_GITHUB_OAUTH_CLIENT_ID=
THREADFORGE_GITHUB_OAUTH_CLIENT_SECRET=
THREADFORGE_GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:18000/api/v1/auth/github/callback
THREADFORGE_GITHUB_OAUTH_RETURN_URL=http://127.0.0.1:5173/
THREADFORGE_GITHUB_OWNER_LOGIN=
# allowlist is the safe default. Use all_authenticated for a public service.
THREADFORGE_GITHUB_ACCESS_POLICY=allowlist
# JSON array, for example: ["sumiim","another-developer"]
THREADFORGE_GITHUB_ALLOWED_LOGINS=[]
THREADFORGE_AUTH_SESSION_TTL_SECONDS=604800
# Keep false for the loopback HTTP tunnel. Set true only with HTTPS.
THREADFORGE_AUTH_COOKIE_SECURE=false

# Optional public HTTPS entry point. Set only after this hostname resolves to
# the server and TCP 80/443 are open. The production deploy then starts Caddy.
THREADFORGE_PUBLIC_HOST=

# Local web console origin.
THREADFORGE_WEB_ORIGIN=http://127.0.0.1:5173
# Set true only when a packaged Electron client must call this API directly.
THREADFORGE_DESKTOP_ORIGIN_ENABLED=false

# Host directory populated by the source-only Worker release workflow.
THREADFORGE_WORKER_RELEASE_DIR=./worker-releases
THREADFORGE_WORKER_RELEASE_MAX_BYTES=134217728

# Timing / limits.
THREADFORGE_APPROVAL_TIMEOUT_SECONDS=1800
THREADFORGE_MODEL_TIMEOUT_SECONDS=120
THREADFORGE_SHELL_CLEANUP_GRACE_SECONDS=5
THREADFORGE_SSE_HEARTBEAT_SECONDS=15
THREADFORGE_MAX_STEPS=6
THREADFORGE_MAX_NEW_TOKENS=512
THREADFORGE_LOG_LEVEL=INFO

# Right Code provider (server-side only; never sent to the browser).
PICO_OPENAI_API_BASE=https://www.right.codes/codex/v1
PICO_OPENAI_API_KEY=
PICO_OPENAI_MODEL=gpt-5.4
